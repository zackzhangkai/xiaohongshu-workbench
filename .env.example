# 阿里云百炼 DashScope API Key（必填）
DASHSCOPE_API_KEY=sk-xxxxxxxx

# 聊天模型（compatible-mode 下的 model 名，可按需改成 qwen-max / qwen-plus / qwen3-max 等）
CHAT_MODEL=qwen-plus

# 生图模型（百炼图像生成：qwen-image 等）
IMAGE_MODEL=qwen-image

# 服务端口
PORT=8787

# 采集本地同步目录（可选；默认 data/exports/collector，设为空值禁用；目录为镜像输出，手工修改会被下次采集覆盖）
# COLLECTOR_SYNC_DIR=

# 数据目录（默认仓库内 data/，一般无需设置）
# DATA_DIR=

# 本地转写（可选）
# TRANSCRIBE_PYTHON=
# TRANSCRIBE_MODEL=
